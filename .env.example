# Shared symmetric key for AES-256-GCM encryption.
# Must be exactly 32 bytes (or any value; code derives SHA256 automatically).
SHARED_KEY=change-this-to-a-strong-32-byte-key

# GitHub repository configuration for the receiver side.
# Example owner values: prashanna or basant
GITHUB_OWNER=prashanna
GITHUB_REPO=secure-file-transfer-demo
GITHUB_BRANCH=main
GITHUB_TOKEN=
GIT_USER_NAME=Secure File Transfer Bot
GIT_USER_EMAIL=secure-bot@example.com

# Host ports
SERVER_A_HOST_PORT=8081
SERVER_B_HOST_PORT=8082
